# Line ending normalization
* text=auto

# Code
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.cginc     text
*.asmdef    text
*.json      text
*.md        text

# Unity YAML (Force Text serialization). Automatically uses Smart Merge (UnityYAMLMerge) if configured.
*.unity          text merge=unityyamlmerge eol=lf
*.prefab         text merge=unityyamlmerge eol=lf
*.asset          text merge=unityyamlmerge eol=lf
*.mat            text merge=unityyamlmerge eol=lf
*.meta           text merge=unityyamlmerge eol=lf
*.controller     text merge=unityyamlmerge eol=lf
*.anim           text merge=unityyamlmerge eol=lf
*.physicMaterial text merge=unityyamlmerge eol=lf
*.inputactions   text eol=lf
*.shadergraph    text eol=lf

# Binary (no diff or merge)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.psd   binary
*.tga   binary
*.fbx   binary
*.glb   binary
*.stl   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.ttf   binary
*.otf   binary
*.zip   binary
